  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate user",
        "description": "[PROPOSED] Endpoint contract; confirm DTO and authorization matrix. / Route đề xuất; cần xác nhận DTO và ma trận quyền.",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Authenticated; exact token/session response TBD"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid credentials"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userNameOrEmail": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "userNameOrEmail",
                  "password"
                ]
              }
            }
          }
        },
        "security": []
      }
    },
