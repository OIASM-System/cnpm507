    "/pos/checkouts": {
      "post": {
        "summary": "Create POS checkout",
        "description": "Proposed endpoint. Use Idempotency-Key for safe retries where supported. Server calculates price and validates stock. / Route đề xuất; server tính giá và kiểm tra tồn.",
        "tags": [
          "POS"
        ],
        "responses": {
          "201": {
            "description": "Checkout persisted"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
