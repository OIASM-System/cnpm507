    "/webhooks/simulator/events": {
      "post": {
        "summary": "Submit simulated webhook event",
        "description": "[PROPOSED] Endpoint contract; confirm DTO and authorization matrix. / Route đề xuất; cần xác nhận DTO và ma trận quyền.",
        "tags": [
          "Webhooks"
        ],
        "responses": {
          "202": {
            "description": "Accepted for processing"
          },
          "400": {
            "description": "Invalid event"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Duplicate/conflicting event"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string"
                  },
                  "eventType": {
                    "type": "string"
                  },
                  "eventId": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "provider",
                  "eventType",
                  "eventId",
                  "payload"
                ]
              }
            }
          }
        }
      }
